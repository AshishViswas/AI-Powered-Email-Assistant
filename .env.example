# Secrets (Do NOT commit real keys)
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FERNET_SECRET_KEY=            # generate with cryptography.fernet.Fernet.generate_key()
SESSION_SECRET=               # random string for session/cookie signing

# Local Development Settings
GOOGLE_REDIRECT_URI=http://localhost:7860/auth/callback
FASTAPI_BACKEND_URL=http://localhost:7860
STREAMLIT_URL=http://localhost:8501
DATABASE_URL=sqlite:///./app.db
ENV=development

# Production Environment (Set in Render Dashboard & Streamlit Cloud Secrets):
# Render (FastAPI Backend):
#   GOOGLE_REDIRECT_URI=https://<actual-render-service>.onrender.com/auth/callback
#   FASTAPI_BACKEND_URL=https://<actual-render-service>.onrender.com
#   STREAMLIT_URL=https://ai-gmail-assistant.streamlit.app
#   DATABASE_URL=sqlite:////data/app.db
#   ENV=production
#
# Streamlit Cloud (UI):
#   FASTAPI_BACKEND_URL=https://<actual-render-service>.onrender.com
#   STREAMLIT_URL=https://ai-gmail-assistant.streamlit.app

SYNC_INTERVAL_SECONDS=600      # background Gmail poll interval
UI_REFRESH_SECONDS=20          # how often browser tab refreshes UI
