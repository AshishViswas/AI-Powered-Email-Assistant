OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://<your-render-app>.onrender.com/auth/callback
FERNET_SECRET_KEY=            # generate with cryptography.fernet.Fernet.generate_key()
SESSION_SECRET=               # random string for session/cookie signing
DATABASE_URL=sqlite:////data/app.db   # /data is the Render persistent disk mount path
SYNC_INTERVAL_SECONDS=600      # how often the background job polls Gmail for new mail
UI_REFRESH_SECONDS=20          # how often an open browser tab re-reads the DB
ENV=development                # or production
